rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 4.1: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(key) {
      return key is string && key.size() == 10 && key.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidStringList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= 120));
    }

    function hasParentUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function isValidUserRoot(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateAccount(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'authProvider', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'authProvider', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.authProvider is string && data.authProvider in ['google.com', 'password', 'unknown']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNutritionProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'name', 'gender', 'age', 'heightCm', 'weightKg',
          'goal', 'activityLevel', 'dietaryTags', 'dietaryNote', 'dislikedFoods',
          'budgetLevel', 'cookingTime', 'cookingSkill', 'kitchenTools', 'healthConditions',
          'likedDishes', 'dislikedDishes', 'triedDishes',
          'bmi', 'bmiCategory', 'bmr', 'tdee', 'targetCalories',
          'targetProtein', 'targetCarbs', 'targetFiber', 'targetFat',
          'waterTargetCups', 'remindMeals', 'remindWater', 'profileCreatedAt',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'name', 'gender', 'age', 'heightCm', 'weightKg',
          'goal', 'activityLevel', 'dietaryTags', 'dietaryNote', 'dislikedFoods',
          'budgetLevel', 'cookingTime', 'cookingSkill', 'kitchenTools', 'healthConditions',
          'likedDishes', 'dislikedDishes', 'triedDishes',
          'bmi', 'bmiCategory', 'bmr', 'tdee', 'targetCalories',
          'targetProtein', 'targetCarbs', 'targetFiber', 'targetFat',
          'waterTargetCups', 'remindMeals', 'remindWater', 'profileCreatedAt',
          'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && data.gender is string && data.gender in ['female', 'male']
        && data.age is number && data.age >= 14 && data.age <= 90
        && data.heightCm is number && data.heightCm >= 120 && data.heightCm <= 220
        && data.weightKg is number && data.weightKg >= 30 && data.weightKg <= 200
        && data.goal is string && data.goal in ['lose_fat', 'maintain', 'gain_weight', 'build_muscle']
        && data.activityLevel is string && data.activityLevel in ['sedentary', 'light', 'moderate', 'active']
        && isValidStringList(data.dietaryTags, 15)
        && data.dietaryNote is string && data.dietaryNote.size() <= 240
        && data.dislikedFoods is string && data.dislikedFoods.size() <= 240
        && data.budgetLevel is string && data.budgetLevel in ['economy', 'balanced', 'flexible']
        && data.cookingTime is string && data.cookingTime in ['no_cook', 'under_15', '15_to_30', 'flexible']
        && data.cookingSkill is string && data.cookingSkill in ['basic', 'intermediate', 'confident']
        && isValidStringList(data.kitchenTools, 15)
        && isValidStringList(data.healthConditions, 15)
        && isValidStringList(data.likedDishes, 30)
        && isValidStringList(data.dislikedDishes, 30)
        && isValidStringList(data.triedDishes, 30)
        && data.bmi is number && data.bmi >= 10 && data.bmi <= 80
        && data.bmiCategory is string && data.bmiCategory.size() >= 1 && data.bmiCategory.size() <= 40
        && data.bmr is number && data.bmr >= 500 && data.bmr <= 6000
        && data.tdee is number && data.tdee >= 700 && data.tdee <= 8000
        && data.targetCalories is number && data.targetCalories >= 900 && data.targetCalories <= 7000
        && data.targetProtein is number && data.targetProtein >= 10 && data.targetProtein <= 600
        && data.targetCarbs is number && data.targetCarbs >= 10 && data.targetCarbs <= 1000
        && data.targetFiber is number && data.targetFiber >= 5 && data.targetFiber <= 150
        && data.targetFat is number && data.targetFat >= 10 && data.targetFat <= 400
        && data.waterTargetCups is number && data.waterTargetCups >= 4 && data.waterTargetCups <= 25
        && data.remindMeals is bool
        && data.remindWater is bool
        && data.profileCreatedAt is string && data.profileCreatedAt.size() >= 10 && data.profileCreatedAt.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMealEntry(data, userId, mealId) {
      return data.keys().hasAll([
          'uid', 'id', 'dateKey', 'slot', 'name', 'time',
          'calories', 'protein', 'carbs', 'fiber', 'fat',
          'sodiumMg', 'sugarG', 'contexts', 'isHealthy',
          'portionEstimate', 'summaryNote', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'id', 'dateKey', 'slot', 'name', 'time',
          'calories', 'protein', 'carbs', 'fiber', 'fat',
          'sodiumMg', 'sugarG', 'contexts', 'isHealthy',
          'portionEstimate', 'summaryNote', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.id is string && data.id == mealId && isValidId(data.id)
        && isValidDateKey(data.dateKey)
        && data.slot is string && data.slot in ['Sáng', 'Trưa', 'Xế', 'Tối']
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.time is string && data.time.size() >= 1 && data.time.size() <= 16
        && data.calories is number && data.calories >= 0 && data.calories <= 10000
        && data.protein is number && data.protein >= 0 && data.protein <= 500
        && data.carbs is number && data.carbs >= 0 && data.carbs <= 1000
        && data.fiber is number && data.fiber >= 0 && data.fiber <= 300
        && data.fat is number && data.fat >= 0 && data.fat <= 500
        && data.sodiumMg is number && data.sodiumMg >= 0 && data.sodiumMg <= 20000
        && data.sugarG is number && data.sugarG >= 0 && data.sugarG <= 500
        && isValidStringList(data.contexts, 10)
        && data.isHealthy is bool
        && data.portionEstimate is string && data.portionEstimate.size() <= 120
        && data.summaryNote is string && data.summaryNote.size() <= 280
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWaterLog(data, userId, dateKey) {
      return data.keys().hasAll(['uid', 'dateKey', 'cups', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'dateKey', 'cups', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.dateKey is string && data.dateKey == dateKey && isValidDateKey(data.dateKey)
        && data.cups is number && data.cups >= 0 && data.cups <= 30
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWeightLog(data, userId, dateKey) {
      return data.keys().hasAll(['uid', 'dateKey', 'weightKg', 'bmi', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'dateKey', 'weightKg', 'bmi', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.dateKey is string && data.dateKey == dateKey && isValidDateKey(data.dateKey)
        && data.weightKg is number && data.weightKg >= 30 && data.weightKg <= 200
        && data.bmi is number && data.bmi >= 10 && data.bmi <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserRoot(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserRoot(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);
      allow delete: if isValidId(userId) && isOwner(userId);

      match /private/{privateDocId} {
        allow get: if isValidId(userId) && privateDocId == 'account' && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && privateDocId == 'account'
          && isOwner(userId)
          && isValidPrivateAccount(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasParentUser(userId);
        allow update: if isValidId(userId)
          && privateDocId == 'account'
          && isOwner(userId)
          && isValidPrivateAccount(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'authProvider', 'updatedAt'])
          && hasParentUser(userId);
        allow delete: if isValidId(userId) && privateDocId == 'account' && isOwner(userId);
      }

      match /profile/{profileDocId} {
        allow get: if isValidId(userId) && profileDocId == 'nutrition' && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && profileDocId == 'nutrition'
          && isOwner(userId)
          && isValidNutritionProfile(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasParentUser(userId);
        allow update: if isValidId(userId)
          && profileDocId == 'nutrition'
          && isOwner(userId)
          && isValidNutritionProfile(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().profileCreatedAt == existing().profileCreatedAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'gender', 'age', 'heightCm', 'weightKg',
            'goal', 'activityLevel', 'dietaryTags', 'dietaryNote', 'dislikedFoods',
            'budgetLevel', 'cookingTime', 'cookingSkill', 'kitchenTools', 'healthConditions',
            'likedDishes', 'dislikedDishes', 'triedDishes',
            'bmi', 'bmiCategory', 'bmr', 'tdee', 'targetCalories',
            'targetProtein', 'targetCarbs', 'targetFiber', 'targetFat',
            'waterTargetCups', 'remindMeals', 'remindWater', 'updatedAt'
          ])
          && hasParentUser(userId);
        allow delete: if isValidId(userId) && profileDocId == 'nutrition' && isOwner(userId);
      }

      match /meals/{mealId} {
        allow get: if isValidId(userId) && isValidId(mealId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && existing().uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(mealId)
          && isOwner(userId)
          && isValidMealEntry(incoming(), userId, mealId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasParentUser(userId);
        allow update: if isValidId(userId)
          && isValidId(mealId)
          && isOwner(userId)
          && isValidMealEntry(incoming(), userId, mealId)
          && incoming().uid == existing().uid
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'dateKey', 'slot', 'name', 'time',
            'calories', 'protein', 'carbs', 'fiber', 'fat',
            'sodiumMg', 'sugarG', 'contexts', 'isHealthy',
            'portionEstimate', 'summaryNote', 'updatedAt'
          ])
          && hasParentUser(userId);
        allow delete: if isValidId(userId) && isValidId(mealId) && isOwner(userId);
      }

      match /waterLogs/{dateKey} {
        allow get: if isValidId(userId) && isValidDateKey(dateKey) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && existing().uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidDateKey(dateKey)
          && isOwner(userId)
          && isValidWaterLog(incoming(), userId, dateKey)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasParentUser(userId);
        allow update: if isValidId(userId)
          && isValidDateKey(dateKey)
          && isOwner(userId)
          && isValidWaterLog(incoming(), userId, dateKey)
          && incoming().uid == existing().uid
          && incoming().dateKey == existing().dateKey
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['cups', 'updatedAt'])
          && hasParentUser(userId);
        allow delete: if isValidId(userId) && isValidDateKey(dateKey) && isOwner(userId);
      }

      match /weightLogs/{dateKey} {
        allow get: if isValidId(userId) && isValidDateKey(dateKey) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && existing().uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidDateKey(dateKey)
          && isOwner(userId)
          && isValidWeightLog(incoming(), userId, dateKey)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasParentUser(userId);
        allow update: if isValidId(userId)
          && isValidDateKey(dateKey)
          && isOwner(userId)
          && isValidWeightLog(incoming(), userId, dateKey)
          && incoming().uid == existing().uid
          && incoming().dateKey == existing().dateKey
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['weightKg', 'bmi', 'updatedAt'])
          && hasParentUser(userId);
        allow delete: if isValidId(userId) && isValidDateKey(dateKey) && isOwner(userId);
      }
    }
  }
}
